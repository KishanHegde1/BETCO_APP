# Render provides PORT automatically. Do not add PORT in Render environment variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Keep this true for Neon. Set false only for an intentionally non-TLS local PostgreSQL instance.
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15d
# A comma-separated list is supported. Do not use * in production.
CORS_ORIGIN=https://your-frontend.example.com
NODE_ENV=production
# Swagger is enabled by default outside production. Enable it explicitly only
# when the deployed API documentation should be public.
SWAGGER_ENABLED=false
TALLY_CONNECTOR_SECRET=replace-with-tally-connector-secret
TALLY_CONNECTOR_ID=replace-with-tally-connector-id
# Mapping order for imported Tally ledgers. Comma-separated values: GSTIN,
# DEALER_CODE, PHONE, NAME. Existing manual mappings always take precedence.
TALLY_MAPPING_PRIORITY=GSTIN,DEALER_CODE,PHONE,NAME
# Required only for the Solar Projects Gallery direct-to-Cloudinary upload flow.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_SOLAR_PROJECTS_FOLDER=betco/solar-projects
# Development seed only. Never set these values in Render production.
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_USER_PASSWORD=ChangeMe123!
