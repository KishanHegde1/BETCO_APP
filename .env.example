# Render provides PORT automatically. Do not add PORT in Render environment variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
# Keep this true for Neon. Set false only for an intentionally non-TLS local PostgreSQL instance.
DATABASE_SSL=true
# Keep certificate verification enabled for Neon. Set false only for an
# intentional local database that uses a self-signed certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15d
# A comma-separated list is supported. Do not use * in production.
CORS_ORIGIN=https://your-frontend.example.com
NODE_ENV=production
# Swagger is enabled by default outside production. Enable it explicitly only
# when the deployed API documentation should be public.
SWAGGER_ENABLED=false
TALLY_CONNECTOR_SECRET=replace-with-tally-connector-secret
TALLY_CONNECTOR_ID=replace-with-tally-connector-id
# Mapping order for imported Tally ledgers. Comma-separated values: GSTIN,
# DEALER_CODE, PHONE, NAME. Existing manual mappings always take precedence.
TALLY_MAPPING_PRIORITY=GSTIN,DEALER_CODE,PHONE,NAME
# Required for Solar Projects, cash proofs, and PM Surya Ghar document uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_SOLAR_PROJECTS_FOLDER=betco/solar-projects
CLOUDINARY_CASH_PROOFS_FOLDER=betco/cash-proofs
# Private authenticated PDFs for PM Surya Ghar applications.
CLOUDINARY_PM_SURYA_GHAR_DOCUMENTS_FOLDER=betco/pm-surya-ghar/documents
# Development seed only. Never set these values in Render production.
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_USER_PASSWORD=ChangeMe123!
