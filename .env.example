PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Keep this true for Neon. Set false only for an intentionally non-TLS local PostgreSQL instance.
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=15d
CORS_ORIGIN=https://your-frontend.example.com
NODE_ENV=development
TALLY_CONNECTOR_SECRET=replace-with-tally-connector-secret
TALLY_CONNECTOR_ID=replace-with-tally-connector-id
# Development seed only. Never set these values in production.
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_USER_PASSWORD=ChangeMe123!
